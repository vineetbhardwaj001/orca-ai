# ORCA AI — prototype / integration profile
# Several integration variables below are reserved for upcoming milestones.

NODE_ENV=development
APP_ENV=prototype
API_PORT=4000
WEB_PORT=5173
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://orca:orca_dev_only@localhost:5432/orca
DATABASE_SSL=false
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Current worker bootstrap reads WORKER_NAME.
WORKER_NAME=orca-prototype-worker
# Reserved: enrollment/control plane is not implemented yet.
WORKER_CONTROL_URL=ws://localhost:4000/worker
WORKER_ENROLLMENT_TOKEN=
WORKER_CAPABILITIES=browser,api,discovery

# Reserved: evidence adapter is not wired into the app yet.
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_PATH=./.evidence

# Reserved: model gateway provider configuration is not wired to API/worker.
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3.5:2b
MODEL_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_TOKEN=
