# ORCA AI — prototype / integration profile
# Target authorization exists; target HTTP/browser execution remains disabled.

NODE_ENV=development
APP_ENV=prototype
API_PORT=4000
WEB_PORT=5173
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://orca:orca_dev_only@localhost:5432/orca
DATABASE_SSL=false
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Current enrolled worker runtime. Never commit enrollment tokens or credential files.
WORKER_NAME=orca-prototype-worker
ORCA_API_BASE_URL=http://127.0.0.1:4000
# ORCA_ENROLLMENT_TOKEN is issued once by an organization owner/admin.
# ORCA_ENROLLMENT_TOKEN=
ORCA_WORKER_CREDENTIAL_FILE=.orca/worker-credential.json
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_VERSION=0.6.0-alpha.1

# Reserved: evidence storage and model provider integrations are not wired into workflows.
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_PATH=./.evidence
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3.5:2b
MODEL_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_TOKEN=
