# ORCA AI — production deployment template
# Do not commit populated production values. Replace placeholders in a secret manager.
# Production is NOT currently an approved/ready deployment target.

NODE_ENV=production
APP_ENV=production
API_PORT=4000
WEB_PORT=5173
API_BASE_URL=https://api.example.com
WEB_BASE_URL=https://app.example.com

# Use managed PostgreSQL with TLS, access restrictions and backups.
DATABASE_URL=postgresql://orca_app:CHANGE_ME@postgres.example.com:5432/orca
DATABASE_SSL=true
DB_POOL_MAX=20

# Reserved for future queue/worker implementation. Not read by current API.
REDIS_URL=rediss://:CHANGE_ME@redis.example.com:6379
WORKER_NAME=orca-production-worker
WORKER_CONTROL_URL=wss://api.example.com/worker
WORKER_ENROLLMENT_TOKEN=CHANGE_ME
WORKER_CAPABILITIES=browser,api,discovery

# Reserved for future evidence storage.
EVIDENCE_STORAGE_DRIVER=s3
EVIDENCE_STORAGE_BUCKET=CHANGE_ME
EVIDENCE_STORAGE_REGION=CHANGE_ME

# Reserved until model gateway is wired into API/worker.
MODEL_PROVIDER=ollama
MODEL_BASE_URL=https://model-gateway.example.com
MODEL_NAME=CHANGE_ME
MODEL_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
HUGGINGFACE_API_TOKEN=CHANGE_ME

# Before production: managed secrets, TLS, backups/restore drills, rate limits,
# audit logs, observability, restricted worker egress, allowlists and kill switch.
