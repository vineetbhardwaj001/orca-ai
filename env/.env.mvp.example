# ORCA AI — MVP / local integration profile
# Safe local-development examples only. Never share real credentials.

NODE_ENV=development
APP_ENV=mvp
API_PORT=4000
WEB_PORT=5173
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# Required when API database-backed routes are used.
DATABASE_URL=postgresql://orca:orca_dev_only@localhost:5432/orca
DATABASE_SSL=false
DB_POOL_MAX=5

# Docker Compose local service settings.
POSTGRES_USER=orca
POSTGRES_PASSWORD=orca_dev_only
POSTGRES_DB=orca

# Worker runtime. Keep enrollment tokens out of committed .env files.
WORKER_NAME=orca-local-worker
ORCA_API_BASE_URL=http://127.0.0.1:4000
# ORCA_ENROLLMENT_TOKEN is a one-time 15-minute token issued by an org owner/admin.
# Set it only in the worker process environment on the first run; do not commit it.
# ORCA_ENROLLMENT_TOKEN=
ORCA_WORKER_CREDENTIAL_FILE=.orca/worker-credential.json
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_VERSION=0.5.0
