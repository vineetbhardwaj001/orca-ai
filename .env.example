# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
APP_ENV=local
API_PORT=4000
WEB_PORT=5173
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://orca:orca_dev_only@localhost:5432/orca
REDIS_URL=redis://localhost:6379

# Generate strong random values locally.
SESSION_SECRET=replace-with-a-long-random-secret
WORKER_ENROLLMENT_SECRET=replace-with-a-long-random-secret
EVIDENCE_SIGNING_SECRET=replace-with-a-long-random-secret

# Optional provider credentials; functionality must degrade gracefully.
GEMINI_API_KEY=
HUGGINGFACE_API_TOKEN=

# Object storage may be configured later.
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_PATH=./.evidence

# Worker
WORKER_NAME=orca-local-worker
WORKER_CONTROL_URL=ws://localhost:4000/worker
WORKER_ENROLLMENT_TOKEN=
WORKER_CAPABILITIES=browser,api,discovery
