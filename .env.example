# Local development environment.
# For MVP/prototype/production templates see env/ and docs/ENVIRONMENT_CONFIGURATION.md.
# Never commit a populated .env file.

NODE_ENV=development
APP_ENV=local
API_PORT=4000
WEB_PORT=5173
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://orca:orca_dev_only@localhost:5432/orca
DATABASE_SSL=false
DB_POOL_MAX=10

POSTGRES_USER=orca
POSTGRES_PASSWORD=orca_dev_only
POSTGRES_DB=orca

# Current worker bootstrap reads WORKER_NAME only.
WORKER_NAME=orca-local-worker

# Reserved for planned features; not consumed by current API/worker yet.
REDIS_URL=redis://localhost:6379
WORKER_CONTROL_URL=ws://localhost:4000/worker
WORKER_ENROLLMENT_TOKEN=
WORKER_CAPABILITIES=browser,api,discovery
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_PATH=./.evidence
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3.5:2b
MODEL_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_TOKEN=
